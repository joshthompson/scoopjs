{
	"name": "@scoopjs/root",
	"version": "0.0.0",
	"private": true,
	"description": "ScoopJS: a game engine where SolidJS components are the game objects",
	"type": "module",
	"license": "MIT",
	"packageManager": "pnpm@12.3.4",
	"scripts": {
		"build": "pnpm -r build",
		"test": "pnpm -r test",
		"typecheck": "pnpm -r typecheck",
		"lint": "biome check .",
		"format": "biome format --write .",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "pnpm build && changeset publish"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"typescript": "^5.9.3"
	}
}
